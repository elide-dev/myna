#!/bin/sh
# Copyright the Myna contributors.
# SPDX-License-Identifier: Apache-2.0 OR MIT
# Upstream Clang does not infer Apple's SDK from SDKROOT as Apple Clang does.
set -eu
case "$(uname -s)-$(uname -m)" in
  Darwin-arm64) target=arm64-apple-darwin ;;
  Linux-x86_64) target=x86_64-unknown-linux-gnu ;;
  Linux-aarch64) target=aarch64-unknown-linux-gnu ;;
  *) echo 'Unsupported native compiler host' >&2; exit 1 ;;
esac
compiler=clang
if [ "${MYNA_CPP:-0}" = 1 ]; then compiler=clang++; fi
if [ "$(uname -s)" = Darwin ]; then
  set -- -isysroot "${SDKROOT:-$(xcrun --show-sdk-path)}" "$@"
fi
compiler_root=${ELIDE_TOOLCHAIN_HOME:-$(dirname "$0")/../.dev/toolchains/native}
exec "$compiler_root/bin/$target-$compiler" "$@"
