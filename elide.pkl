amends "elide:project.pkl"
import "elide:Jvm.pkl" as Jvm
import "elide:Sources.pkl" as Sources
import "elide:NativeImage.pkl" as Native
import "elide:Testing.pkl" as Testing
import "elide:Coverage.pkl" as Coverage

name = "myna"
version = "0.6.0"
jvm {
  main = "dev.elide.myna.cli.Main"
  target = 25
}
sources {
  ["main"] = new Sources.SourceSetSpec {
    paths { "src/main/java/**/*.java" }
  }
  ["feature"] = new Sources.SourceSetSpec {
    dependsOn { "main" }
    paths { "src/feature/java/**/*.java" }
  }
  ["test"] = new Sources.SourceSetSpec {
    dependsOn { "main"; "feature" }
    paths { "src/test/java/**/*.java" }
  }
}
artifacts {
  ["jar"] = new Jvm.Jar {
    name = "myna"
    main = "dev.elide.myna.cli.Main"
    sources { "main" }
  }
  ["feature-jar"] = new Jvm.Jar {
    name = "myna-feature"
    sources { "main"; "feature" }
  }
  ["native"] = new Native.NativeImage {
    name = "myna"
    from { "jar" }
    entrypoint = "dev.elide.myna.cli.Main"
    options {
      optimization = "2"
      driverMode = "embedded"
      flags {
        "-J--enable-native-access=ALL-UNNAMED"
        // Elide 1.6.1 cannot initialize its inference engine: runtime#2692.
        "-H:+UnlockExperimentalVMOptions"
        "-H:-MLProfileInference"
        "-H:-UnlockExperimentalVMOptions"
      }
      classInit { default = "runtime" }
    }
  }
}

dependencies {
  maven {
    compileOnly { "org.graalvm.sdk:nativeimage:25.4.4.1.1" }
    testPackages { "org.junit.jupiter:junit-jupiter:6.1.3"; "org.graalvm.sdk:nativeimage:25.4.4.1.1" }
  }
}


testing {
  reports { Testing.xmlReport() }
}

coverage {
  enabled = true
  scope = "tests"
  jvm {
    reports { Coverage.xmlReport(); Coverage.htmlReport() }
  }
}
