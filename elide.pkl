// SPDX-License-Identifier: Apache-2.0 OR MIT
amends "elide:project.pkl"
import "elide:Jvm.pkl" as Jvm
import "elide:Sources.pkl" as Sources
import "elide:Testing.pkl" as Testing
import "elide:Coverage.pkl" as Coverage

name = "myna"
version = "0.13.0"
jvm {
  main = "dev.elide.myna.cli.Main"
  target = 25
}
sources {
  ["main"] = new Sources.SourceSetSpec {
    paths { "src/main/java/**/*.java" }
  }
  ["values"] = new Sources.SourceSetSpec {
    paths { "src/values/java/**/*.java" }
  }
  ["feature"] = new Sources.SourceSetSpec {
    dependsOn { "main" }
    paths { "src/feature/java/**/*.java" }
  }
  ["truffle"] = new Sources.SourceSetSpec {
    paths { "src/truffle/java/**/*.java" }
  }
  ["test"] = new Sources.SourceSetSpec {
    dependsOn { "main"; "feature"; "values"; "truffle" }
    paths { "src/test/java/**/*.java" }
  }
}
artifacts {
  ["jar"] = new Jvm.Jar {
    name = "myna"
    resources {
      new { from = "LICENSE"; into = "META-INF" }
      new { from = "LICENSE-APACHE"; into = "META-INF" }
      new { from = "LICENSE-MIT"; into = "META-INF" }
    }
    main = "dev.elide.myna.cli.Main"
    sources { "main" }
  }
  ["values-jar"] = new Jvm.Jar {
    name = "myna-values"
    resources {
      new { from = "LICENSE"; into = "META-INF" }
      new { from = "LICENSE-APACHE"; into = "META-INF" }
      new { from = "LICENSE-MIT"; into = "META-INF" }
    }
    sources { "values" }
  }
  ["feature-jar"] = new Jvm.Jar {
    name = "myna-feature"
    resources {
      new { from = "LICENSE"; into = "META-INF" }
      new { from = "LICENSE-APACHE"; into = "META-INF" }
      new { from = "LICENSE-MIT"; into = "META-INF" }
    }
    sources { "main"; "feature" }
  }
  ["truffle-jar"] = new Jvm.Jar {
    name = "myna-truffle"
    resources {
      new { from = "LICENSE"; into = "META-INF" }
      new { from = "LICENSE-APACHE"; into = "META-INF" }
      new { from = "LICENSE-MIT"; into = "META-INF" }
      new {
        from = "src/truffle/resources/META-INF/native-image/dev.elide.myna/myna-truffle/native-image.properties"
        into = "META-INF/native-image/dev.elide.myna/myna-truffle"
      }
    }
    sources { "truffle" }
  }

}

dependencies {
  maven {
    repositories { ["gvm-elide"] = "https://maven.elide.dev/gvm-elide/25.5.5-elide.28" }
    compileOnly { "org.graalvm.sdk:nativeimage:25.5.5-elide.28"; "org.graalvm.truffle:truffle-api:25.5.5-elide.28" }
    processors { "org.graalvm.truffle:truffle-dsl-processor:25.5.5-elide.28" }
    testPackages {
      "org.junit.jupiter:junit-jupiter:6.1.3"
      "org.graalvm.sdk:nativeimage:25.5.5-elide.28"
      "org.graalvm.truffle:truffle-api:25.5.5-elide.28"
    }
  }
}


testing {
  reports { Testing.xmlReport() }
}

coverage {
  enabled = true
  scope = "tests"
  jvm {
    reports { Coverage.xmlReport(); Coverage.htmlReport() }
  }
}
