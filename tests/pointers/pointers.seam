# Typed struct pointers in Java FFM: a ptr<S> to a declared struct, returned or read from a field, is a
# segment sized to S. Leaf and Node point to each other and Node to itself, so two of the field
# layouts close a cycle; the opaque and scalar pointers stay unsized.
module pointers target=x86_64-unknown-linux-gnu java_package=fixture.pointers java_class=Pointers
opaque Handle
struct Leaf size=16 align=8
  field weight type=f64 offset=0
  field owner type=ptr<Node> offset=8
end
struct Node size=40 align=8
  field value type=i64 offset=0
  field next type=ptr<Node> offset=8
  field leaf type=ptr<Leaf> offset=16
  field handle type=ptr<Handle> offset=24
  field name type=ptr<char> offset=32
end
# The first of two nodes in static storage.
import head symbol=pointers_head return=ptr<Node> error=no_failure
end
# The null node pointer.
import none symbol=pointers_none return=ptr<Node> error=no_failure
end
import weigh symbol=pointers_weigh return=f64 error=no_failure
  param leaf type=ptr<Leaf> nullable=false ownership=borrowed access=read
end
