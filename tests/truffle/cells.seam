# Truffle cells over a static C fixture: leaves inline and transitioning imports call their AOT
# stubs directly from compiled code (elide-dev/graal#196 on the pinned fork).
module truffle_fixture target=aarch64-apple-darwin java_package=fixture.cells java_class=CellApi truffle_cells=true c_context=fixture.cells.Directives c_library=cellsfixture c_library_static=true
opaque Counter
resource Counter representation=native threading=confined create=counterCreate destroy=counterDestroy
opaque Stepper
resource Stepper representation=native threading=confined create=stepperCreate destroy=stepperDestroy
import add symbol=cells_add return=i32 error=no_failure
  param left type=i32
  param right type=i32
end
import widen symbol=cells_widen return=i64 error=no_failure
  param small type=u8
  param medium type=u16
  param wide type=u32
  param flag type=bool
end
import scale symbol=cells_scale return=f64 error=no_failure
  param value type=f32
  param factor type=f64
end
import lowByte symbol=cells_low_byte return=u8 error=no_failure
  param value type=i64
end
import peek symbol=cells_peek return=i64 error=no_failure
  param cell type=ptr<i64> nullable=false ownership=borrowed access=read nonnull=true@explicit_contract readonly=true@explicit_contract
end
import poke symbol=cells_poke return=void error=no_failure
  param cell type=ptr<i64> nullable=false ownership=borrowed access=write
  param value type=i64
end
import rawLength symbol=cells_raw_length return=usize error=no_failure truffle_raw_pointers=true@explicit_contract
  param text type=ptr<void>
end
import strlen symbol=cells_strlen return=usize error=no_failure
  param text type=ptr<char> nullable=false ownership=borrowed access=read nonnull=true@explicit_contract readonly=true@explicit_contract
end
borrow checksum bytes length=count lifetime=call
import checksum symbol=cells_checksum return=u64 error=no_failure nounwind=true@explicit_contract
  param bytes type=ptr<u8> nullable=false ownership=borrowed access=read nocapture=true@explicit_contract readonly=true@explicit_contract
  param count type=u64
end
borrow fill bytes length=count lifetime=call
import fill symbol=cells_fill return=void error=no_failure nounwind=true@explicit_contract
  param bytes type=ptr<u8> nullable=false ownership=borrowed access=read_write nocapture=true@explicit_contract
  param count type=u32
  param value type=u8
end
borrow transfer input length=count lifetime=call
borrow transfer output length=capacity lifetime=call
import transfer symbol=cells_transfer return=u64 error=no_failure nounwind=true@explicit_contract
  param input type=ptr<u8> nullable=false ownership=borrowed access=read nocapture=true@explicit_contract readonly=true@explicit_contract
  param count type=u64
  param output type=ptr<u8> nullable=false ownership=borrowed access=write nocapture=true@explicit_contract
  param capacity type=u32
  param copied type=ptr<i64> nullable=true ownership=borrowed access=write
end
# A nullable borrow: the guest passes null for an absent output buffer, and the cell lends the null
# address and derives length zero.
borrow decode data length=length lifetime=call
borrow decode text length=capacity lifetime=call
import decode symbol=cells_decode return=u64 error=no_failure nounwind=true@explicit_contract
  param data type=ptr<u8> nullable=false ownership=borrowed access=read nocapture=true@explicit_contract readonly=true@explicit_contract
  param length type=u64
  param text type=ptr<u8> nullable=true ownership=borrowed access=write nocapture=true@explicit_contract
  param capacity type=u32
end
import sumBytes symbol=cells_sum_bytes return=u64 error=no_failure nounwind=true@explicit_contract
  param bytes type=ptr<u8> nullable=false ownership=borrowed access=read nocapture=true@explicit_contract readonly=true@explicit_contract truffle_buffer=true@explicit_contract
  param count type=u64
  param bias type=ptr<i64> nullable=true ownership=borrowed access=read
end
import counterCreate symbol=cells_counter_create return=ptr<Counter> error=no_failure nounwind=true@explicit_contract native_leaf=false@explicit_contract
  param start type=i64
end
import counterDestroy symbol=cells_counter_destroy return=void error=no_failure nounwind=true@explicit_contract native_leaf=false@explicit_contract
  param counter type=ptr<Counter> nullable=false ownership=transferred_to_callee access=read_write
end
import counterNext symbol=cells_counter_next return=i64 error=no_failure
  param counter type=ptr<Counter> nullable=false ownership=borrowed access=read_write
end
import counterLive symbol=cells_counter_live return=i64 error=no_failure
end
import sleepyAdd symbol=cells_sleepy_add return=i64 error=no_failure native_leaf=false@explicit_contract
  param left type=i64
  param right type=i64
end
import pair symbol=cells_pair return=i64 error=no_failure
  param left type=ptr<char> nullable=false ownership=borrowed access=read nonnull=true@explicit_contract readonly=true@explicit_contract
  param right type=ptr<char> nullable=false ownership=borrowed access=read nonnull=true@explicit_contract readonly=true@explicit_contract
end
import stepperCreate symbol=cells_stepper_create return=ptr<Stepper> error=no_failure nounwind=true@explicit_contract native_leaf=false@explicit_contract
  param counter type=ptr<Counter> nullable=false ownership=borrowed access=read_write
  param step type=ptr<i64> nullable=false ownership=borrowed access=read
end
import stepperDestroy symbol=cells_stepper_destroy return=void error=no_failure nounwind=true@explicit_contract native_leaf=false@explicit_contract
  param stepper type=ptr<Stepper> nullable=false ownership=transferred_to_callee access=read_write
end
import stepperNext symbol=cells_stepper_next return=i64 error=no_failure
  param stepper type=ptr<Stepper> nullable=false ownership=borrowed access=read_write
end
opaque Layout
struct LayoutResult size=24 align=8
  field count type=u64 offset=0
  field data type=ptr<Layout> offset=8
  field capacity type=u64 offset=16
end
resource Layout representation=native threading=confined create=layoutCompile destroy=layoutRelease handle=result.data success=0,2
borrow layoutCompile schema length=length lifetime=call
import layoutCompile symbol=cells_layout_compile return=i32 error=no_failure nounwind=true@explicit_contract native_leaf=false@explicit_contract
  param schema type=ptr<u8> nullable=false ownership=borrowed access=read nocapture=true@explicit_contract readonly=true@explicit_contract
  param length type=u64
  param result type=ptr<LayoutResult> nullable=false ownership=borrowed access=write
end
import layoutRelease symbol=cells_layout_release return=void error=no_failure nounwind=true@explicit_contract native_leaf=false@explicit_contract
  param layout type=ptr<Layout> nullable=false ownership=transferred_to_callee access=read_write
end
import layoutWidth symbol=cells_layout_width return=i64 error=no_failure
  param layout type=ptr<Layout> nullable=false ownership=borrowed access=read
end
struct View size=16 align=8
  field sum type=i64 offset=0
  field scratch type=ptr<u8> offset=8
end
resource View representation=native threading=confined create=viewInit destroy=viewRelease handle=view success=0
borrow viewInit data length=length lifetime=call
import viewInit symbol=cells_view_init return=i32 error=no_failure nounwind=true@explicit_contract native_leaf=false@explicit_contract
  param data type=ptr<u8> nullable=false ownership=borrowed access=read nocapture=true@explicit_contract readonly=true@explicit_contract
  param length type=u64
  param view type=ptr<View> nullable=false ownership=borrowed access=write
end
import viewRelease symbol=cells_view_release return=void error=no_failure nounwind=true@explicit_contract native_leaf=false@explicit_contract
  param view type=ptr<View> nullable=false ownership=transferred_to_callee access=read_write
end
import viewSum symbol=cells_view_sum return=i64 error=no_failure
  param view type=ptr<View> nullable=false ownership=borrowed access=read
end
