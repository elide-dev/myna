# Enum and flag returns through the ownership wrappers (resource create and call borrows).
module constants_owned target=x86_64-unknown-linux-gnu java_package=fixture.constants.owned java_class=Owned
opaque Ticket
resource Ticket representation=native threading=shared create=ticketCreate destroy=ticketDestroy
enum Status type=i32
  value ok = 0
  value bad = -1
end
flags Perms type=u32
  bit read = 0
  bit write = 1
end

import ticketCreate symbol=owned_ticket_create return=ptr<Ticket> error=no_failure nounwind=true@explicit_contract native_leaf=false@explicit_contract
end
import ticketDestroy symbol=owned_ticket_destroy return=void error=no_failure nounwind=true@explicit_contract native_leaf=false@explicit_contract
  param ticket type=ptr<Ticket> nullable=false ownership=transferred_to_callee access=read_write
end
borrow check bytes length=count lifetime=call
import check symbol=owned_check return=i32 error=no_failure nounwind=true@explicit_contract native_leaf=false@explicit_contract enum=Status
  param bytes type=ptr<u8> nullable=false ownership=borrowed access=read nocapture=true@explicit_contract readonly=true@explicit_contract
  param count type=u64
  param mode type=i32 enum=Status
end
borrow permissions bytes length=count lifetime=call
import permissions symbol=owned_permissions return=u32 error=no_failure nounwind=true@explicit_contract native_leaf=false@explicit_contract flags=Perms
  param bytes type=ptr<u8> nullable=false ownership=borrowed access=read nocapture=true@explicit_contract readonly=true@explicit_contract
  param count type=u64
  param wanted type=u32 flags=Perms
end
