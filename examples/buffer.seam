# Owned by this repo: a deliberately small, testable Native Image / Rust seam.
module buffer abi=1 target=aarch64-apple-darwin
opaque Buffer
struct BufferView size=24 align=8
  field data type=ptr<u8> offset=0
  field length type=u64 offset=8
  field flags type=u32 offset=16
end
# This leaf implementation only reads one off-heap i64; no blocking or Java callbacks.
import inspect native_leaf=true@explicit_contract symbol=seam_inspect return=i64 error=no_failure nounwind=true@explicit_contract willreturn=true@explicit_contract
  param value type=ptr<i64> nullable=false ownership=borrowed access=read nonnull=true@explicit_contract nocapture=true@explicit_contract readonly=true@explicit_contract align=8@explicit_contract dereferenceable=8@explicit_contract
end
export sum symbol=seam_sum return=i64 java=fixture.BufferOps.sum isolate=thread error=integer_sentinel sentinel=-1 nounwind=true@explicit_contract
  param data type=ptr<u8> nullable=false ownership=borrowed access=read nonnull=true@explicit_contract
  param length type=i64
end
# Sub-32-bit values in both directions; each target's C extension rule applies (docs/dsl.md).
import widen native_leaf=true@explicit_contract symbol=seam_widen return=i32 error=no_failure nounwind=true@explicit_contract willreturn=true@explicit_contract
  param signedByte type=i8
  param unsignedByte type=u8
  param signedShort type=i16
  param unsignedShort type=u16
  param flag type=bool
end
export classify symbol=seam_classify return=i8 java=fixture.BufferOps.classify isolate=thread error=abort
  param value type=i16
  param strict type=bool
end
export isHigh symbol=seam_is_high return=bool java=fixture.BufferOps.isHigh isolate=thread error=abort
  param value type=u8
end
import lowUnsigned native_leaf=true@explicit_contract symbol=seam_low_unsigned return=u8 error=no_failure nounwind=true@explicit_contract willreturn=true@explicit_contract
  param value type=i32
end
import lowSigned native_leaf=true@explicit_contract symbol=seam_low_signed return=i8 error=no_failure nounwind=true@explicit_contract willreturn=true@explicit_contract
  param value type=i32
end
export echo symbol=seam_echo return=u8 java=fixture.BufferOps.echo isolate=thread error=abort
  param value type=u8
end
# Callbacks: Java hands Rust an entry point plus its isolate thread; Rust hands Java a function pointer.
callback Visitor return=i32
  param isolate type=isolate_thread
  param value type=i64
end
callback Reducer return=i64
  param left type=i64
  param right type=i64
end
export visit symbol=seam_visit return=i32 java=fixture.BufferOps.visit isolate=thread error=abort callback=Visitor
  param value type=i64
end
import forEach symbol=seam_for_each return=i32 error=no_failure
  param visitor type=fn<Visitor>
  param isolate type=isolate_thread
  param count type=i64
end
import reducer symbol=seam_reducer return=fn<Reducer> error=no_failure
end
export exercise symbol=seam_exercise return=i64 java=fixture.BufferOps.exercise isolate=thread error=abort
end
